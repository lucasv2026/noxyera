# Supabase — trouvez ces valeurs dans Settings > API de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service_role (backend uniquement, ne pas exposer côté client)
# Utilisée par /api/leads pour contourner le RLS et écrire directement
SUPABASE_SERVICE_ROLE_KEY=eyJ...
